<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Spaceflight Simulator Blueprints</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <nav class="navbar">
    <div class="navbar-container">
      <h1 class="logo">🚀 Spaceflight Blueprints</h1>
      <div class="navbar-buttons">
        <button id="adminBtn" class="btn-admin">Admin Login</button>
      </div>
    </div>
  </nav>

  <div id="adminModal" class="modal hidden">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Admin Registration</h2>
      <p>Enter the one-time admin code to register as admin:</p>
      <input type="password" id="adminCodeInput" placeholder="Enter admin code">
      <button id="submitAdminCode" class="btn-primary">Register as Admin</button>
      <div id="adminMessage" class="admin-message"></div>
    </div>
  </div>

  <div id="publishModal" class="modal hidden">
    <div class="modal-content">
      <span class="close">&times;</span>
      <h2>Publish Blueprint</h2>
      <input type="text" id="blueprintTitle" placeholder="Blueprint Title" required>
      <textarea id="blueprintDesc" placeholder="Description (optional)"></textarea>
      <input type="url" id="blueprintLink" placeholder="Download Link" required>
      <button id="submitBlueprint" class="btn-primary">Publish Blueprint</button>
      <div id="publishMessage" class="admin-message"></div>
    </div>
  </div>

  <main class="container">
    <section id="adminSection" class="admin-section hidden">
      <h2>Admin Panel</h2>
      <button id="publishBtn" class="btn-primary">Publish New Blueprint</button>
      <div id="myBlueprints" class="blueprints-grid"></div>
    </section>

    <section id="blueprintsSection" class="blueprints-section">
      <h2>Available Blueprints</h2>
      <div id="blueprintsList" class="blueprints-grid"></div>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>
